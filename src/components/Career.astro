---
import {career} from '../career';
import {language} from '../i18n';
import Icon from './Icon.astro';
const lang=language(Astro.url.pathname);const en=lang==='en';const c=career(lang);
---
<section id="werdegang" class="section career-section"><div class="container">
 <div class="section-heading"><div><p class="eyebrow">03 / {en?'EXPERIENCE THAT CONNECTS THE DOTS':'ERFAHRUNG, DIE PERSPEKTIVEN VERBINDET'}</p><h2>{en?'My journey.':'Mein Werdegang.'}<br/><span class="muted-heading">{en?'From studying to expertise.':'Vom Studium zur Expertin.'}</span></h2></div><p>{en?'Each chapter adds a new perspective. Today, I bring design, computer science and quality together to create more accessible digital experiences.':'Jede Station bringt eine neue Perspektive. Heute verbinde ich Design, Informatik und Qualität zu zugänglicheren digitalen Erlebnissen.'}</p></div>
 <div class="career-switch" role="group" aria-label={en?'Choose career view':'Werdegang-Ansicht wählen'}><button type="button" data-career="work" aria-pressed="true">{en?'Professional experience':'Beruflicher Weg'}<span>06</span></button><button type="button" data-career="education" aria-pressed="false">{en?'Education & studies':'Studium & Ausbildung'}<span>04</span></button></div>
 <div class="career-panel" data-career-panel="work"><ol class="career-timeline">{c.work.map((entry,index)=><li class:list={{'career-current':entry.current}}><div class="career-date"><span class="mono">{entry.date}</span>{entry.current&&<span class="current-badge"><span class="status-dot"/>{en?'CURRENT CHAPTER':'AKTUELLES KAPITEL'}</span>}</div><article class="career-entry"><span class="career-node" aria-hidden="true">{index===0?'↗':'+'}</span><span class="career-place">{entry.place}</span><h3>{entry.title}</h3><p>{entry.text}</p><div class="career-tags">{entry.tags.map(t=><span>{t}</span>)}</div></article></li>)}</ol></div>
 <div class="career-panel" data-career-panel="education"><ol class="career-timeline">{c.education.map(entry=><li><div class="career-date"><span class="mono">{entry.date}</span></div><article class="career-entry"><span class="career-node" aria-hidden="true">+</span><span class="career-place">{entry.place}</span><h3>{entry.title}</h3><p>{entry.text}</p><div class="career-tags">{entry.tags.map(t=><span>{t}</span>)}</div></article></li>)}</ol></div>
 <div class="career-download"><div><span class="mono">{en?'TAKE THE DETAILS WITH YOU':'ALLE DETAILS ZUM MITNEHMEN'}</span><p>{en?'My experience, in a little more detail.':'Mein Hintergrund. Zum Nachlesen.'}</p></div><a class="text-link" href="/downloads/Georgia_Koenig_Lebenslauf_2025.pdf">{en?'CV · German PDF, 2025':'Lebenslauf · PDF, 2025'}<Icon name="download" size={18}/></a><a class="text-link" href="/downloads/Georgia_Koenig_Qualifikationsprofil_2025.pdf">{en?'Skills profile · German PDF, 2025':'Qualifikationsprofil · PDF, 2025'}<Icon name="download" size={18}/></a></div>
</div></section>
<script>
 document.querySelectorAll<HTMLElement>('.career-section').forEach(section=>{
  const buttons=section.querySelectorAll<HTMLButtonElement>('[data-career]');
  const panels=section.querySelectorAll<HTMLElement>('[data-career-panel]');
  const reduced=matchMedia('(prefers-reduced-motion: reduce)');
  const running=new Set<Animation>();
  let selected='work';
  let observer:IntersectionObserver|undefined;
  const remember=(animation:Animation)=>{running.add(animation);animation.finished.then(()=>running.delete(animation)).catch(()=>running.delete(animation));};
  function reveal(row:HTMLElement,delay=0) {
   if(row.classList.contains('is-visible')||row.closest<HTMLElement>('[data-career-panel]')?.hidden)return;
   row.classList.add('is-visible');
   if(reduced.matches||typeof row.animate!=='function')return;
   remember(row.animate([{opacity:0,transform:'translateY(28px)'},{opacity:1,transform:'translateY(0)'}],{duration:700,delay,easing:'cubic-bezier(.16,1,.3,1)',fill:'backwards'}));
   const node=row.querySelector<HTMLElement>('.career-node');
   if(node)remember(node.animate([{transform:'scale(.7)'},{transform:'scale(1.12)',offset:.65},{transform:'scale(1)'}],{duration:650,delay:delay+80,easing:'cubic-bezier(.16,1,.3,1)',fill:'backwards'}));
  }
  function observePanel() {
   observer?.disconnect();
   const rows=section.querySelectorAll<HTMLElement>('[data-career-panel]:not([hidden]) .career-timeline>li');
   if(reduced.matches||!('IntersectionObserver' in window)){rows.forEach(row=>row.classList.add('is-visible'));return;}
   observer=new IntersectionObserver(entries=>{
    entries.filter(entry=>entry.isIntersecting).forEach((entry,index)=>{reveal(entry.target as HTMLElement,Math.min(index*90,180));observer?.unobserve(entry.target);});
   },{threshold:.08,rootMargin:'0px 0px -40px 0px'});
   rows.forEach(row=>observer?.observe(row));
  }
  function select(view:string,animate=false) {
   if(animate&&view===selected)return;
   running.forEach(animation=>animation.cancel());running.clear();selected=view;
   buttons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.career===view)));
   panels.forEach(panel=>{panel.hidden=panel.dataset.careerPanel!==view;if(!panel.hidden)panel.querySelectorAll('.is-visible').forEach(row=>row.classList.remove('is-visible'));});
   if(animate&&!reduced.matches){const button=section.querySelector<HTMLButtonElement>(`[data-career="${view}"]`);if(button?.animate)remember(button.animate([{transform:'scale(.97)'},{transform:'scale(1)'}],{duration:250,easing:'ease-out'}));}
   observePanel();
  }
  reduced.addEventListener('change',()=>{running.forEach(animation=>animation.cancel());running.clear();observePanel();});
  select('work');buttons.forEach(b=>b.addEventListener('click',()=>select(b.dataset.career!,true)));
 });
</script>
