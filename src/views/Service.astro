---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ServiceDemo from '../components/ServiceDemo';
import {services,person} from '../data';
import {servicesEn} from '../data-en';
import {language,href} from '../i18n';
import {serviceStory} from '../service-stories';
import '../styles/services.css';
const {service}=Astro.props;
const lang=language(Astro.url.pathname),en=lang==='en';
const t=(de:string,english:string)=>en?english:de;
const story=serviceStory(service.slug,lang);
const related=(en?servicesEn:services).filter(s=>s.slug!==service.slug);
const contact=`mailto:${person.email}?subject=${encodeURIComponent(t('Anfrage: ','Enquiry: ')+service.title)}`;
---
<Layout title={`${service.title} – Georgia König`} description={service.description} schema={{'@type':'Service',name:service.title,description:service.description,provider:{'@id':person.url+'/#business'},url:new URL(Astro.url.pathname,person.url).href}}>
 <div class={`service-page service-${service.icon}`}>
  <section class="service-hero container" aria-labelledby="service-title">
   <nav class="service-breadcrumb" aria-label={t('Brotkrümelnavigation','Breadcrumb')}><a href={href('/',lang)}>{t('Startseite','Home')}</a><span aria-hidden="true">/</span><a href={href('/',lang)+'#leistungen'}>{t('Leistungen','Services')}</a><span aria-hidden="true">/</span><span aria-current="page">{service.title}</span></nav>
   <div class="service-hero-grid"><div class="service-introduction"><p class="eyebrow"><span>{service.number} /</span> {service.title}</p><h1 id="service-title">{story.headline[0]}<br/><span>{story.headline[1]}</span></h1><p class="service-lead">{story.intro}</p><a class="button button-mint" href={contact}>{t('Dein Projekt besprechen','Discuss your project')}<Icon name="diagonal" size={20}/></a><div class="service-audience"><span>{t('Ein guter Start für','A good starting point for')}</span><ul>{story.audience.map(a=><li>{a}</li>)}</ul></div></div><ServiceDemo kind={service.icon} en={en} client:load/></div>
   <a class="service-explore" href="#mehrwert"><span aria-hidden="true">↓</span>{t('So wird aus deiner Idee ein nächster Schritt','Turn your idea into a next step')}</a>
  </section>
  <section id="mehrwert" class="service-benefits service-section" aria-labelledby="benefit-title"><div class="container"><div class="service-section-heading" data-service-reveal><p class="eyebrow">{t('DER MEHRWERT','THE VALUE')}</p><h2 id="benefit-title">{t('Nicht nur schöner.','Beyond appearances.')}<br/><span>{t('Sondern sinnvoller.','Towards meaningful change.')}</span></h2></div><div class="benefit-grid">{story.benefits.map((b,i)=><article data-service-reveal><div class="benefit-symbol"><Icon name={b.icon} size={32}/><span>0{i+1}</span></div><h3>{b.title}</h3><p>{b.text}</p></article>)}</div></div></section>
  <section class="container service-section service-change" aria-labelledby="change-title"><div data-service-reveal><p class="eyebrow">{t('KLEINE ENTSCHEIDUNGEN. GROSSE WIRKUNG.','SMALL DECISIONS. MEANINGFUL CHANGE.')}</p><h2 id="change-title">{t('Was sich verändern kann.','What can change.')}</h2><p>{t('Typische Situationen zeigen, worauf wir gemeinsam hinarbeiten können.','Typical situations show what we can work towards together.')}</p><span class="service-example-label">{t('Illustrative Beispiele','Illustrative examples')}</span></div><div class="change-rows">{story.changes.map(([before,after],i)=><div class="change-row" data-service-reveal><span class="change-number">0{i+1}</span><div><span class="change-label">{t('Ausgangslage','Starting point')}</span><p>{before}</p></div><span class="change-arrow" aria-hidden="true">↗</span><div><span class="change-label">{t('Unser Ziel','Our goal')}</span><p>{after}</p></div></div>)}</div></section>
  <section class="service-process service-section" aria-labelledby="process-title"><div class="container service-process-grid"><div class="process-intro" data-service-reveal><p class="eyebrow">{t('VON DER FRAGE ZUM ERGEBNIS','FROM QUESTION TO OUTCOME')}</p><h2 id="process-title">{t('Ein klarer Weg.','A clear path.')}<br/><span>{t('Gemeinsam mit dir.','Together with you.')}</span></h2><p>{t('Jedes Vorhaben ist anders. Dieser Ablauf gibt Orientierung – die einzelnen Schritte stimmen wir auf dein Projekt ab.','Every project is different. This process offers orientation; we adapt the individual steps to your project.')}</p><a class="service-text-link" href={contact}>{t('Wo stehst du gerade?','Where are you today?')}<Icon name="arrow" size={20}/></a></div><div class="process-steps">{story.steps.map((step,i)=><details class="process-step" open={i===0} data-service-reveal><summary><span class="step-number">0{i+1}</span><h3>{step.title}</h3><span class="step-toggle" aria-hidden="true">+</span></summary><div class="step-content"><p>{step.text}</p><div class="step-output"><Icon name="arrow" size={18}/><span>{step.output}</span></div></div></details>)}</div></div></section>
  <section class="container service-section" aria-labelledby="results-title"><div class="service-section-heading split-heading" data-service-reveal><div><p class="eyebrow">{t('GREIFBAR WEITERARBEITEN','SOMETHING TO BUILD ON')}</p><h2 id="results-title">{t('Was du mitnehmen kannst.','What you can take away.')}</h2></div><p>{t('Verständlich dokumentiert und anschlussfähig für dein Team. Welche Ergebnisse du brauchst, vereinbaren wir gemeinsam.','Clearly documented and useful to your team. We agree together on the deliverables you need.')}</p></div><div class="deliverable-grid">{story.deliverables.map((d,i)=><article class="deliverable" data-service-reveal><div class="document-preview" aria-hidden="true"><div class="document-top"><span>GK / 0{i+1}</span><Icon name="diagonal" size={20}/></div><div class="document-title">{d.title}</div>{d.rows.map((r,j)=><div class="document-row"><span class="document-dot"/>{r}<span>{j===0?'↗':'—'}</span></div>)}<div class="document-bottom"><span>Georgia König</span><span>0{i+1}</span></div></div><h3>{d.title}</h3><p>{d.text}</p></article>)}</div></section>
  <section class="container service-section service-scope" aria-labelledby="scope-title"><div data-service-reveal><p class="eyebrow">{t('PASSEND ZU DEINEM VORHABEN','TAILORED TO YOUR PROJECT')}</p><h2 id="scope-title">{t('Hier kann ich unterstützen.','How I can support you.')}</h2><p>{service.intro}</p></div><ul>{service.items.map((item:string)=><li data-service-reveal><Icon name="check" size={22}/><span>{item}</span></li>)}</ul></section>
  <section class="service-faq service-section" aria-labelledby="faq-title"><div class="container service-faq-grid"><div data-service-reveal><p class="eyebrow">{t('GUT ZU WISSEN','GOOD TO KNOW')}</p><h2 id="faq-title">{t('Noch Fragen?','Any questions?')}</h2><p>{t('Hier findest du erste Antworten. Über dein konkretes Vorhaben sprechen wir am besten persönlich.','Here are some initial answers. Let’s discuss your specific project in person.')}</p></div><div>{story.faqs.map(faq=><details data-service-reveal><summary>{faq.q}<span aria-hidden="true">+</span></summary><p>{faq.a}</p></details>)}</div></div></section>
  <section class="container service-section service-next" aria-labelledby="next-title"><div class="service-next-inner" data-service-reveal><span class="next-symbol" aria-hidden="true"><Icon name={service.icon} size={56}/></span><p class="eyebrow">{t('DEIN NÄCHSTER SCHRITT','YOUR NEXT STEP')}</p><h2 id="next-title">{t('Lass uns dein Vorhaben','Let’s bring your project')}<br/>{t('weiterdenken.','into focus.')}</h2><p>{t('Eine Idee, eine konkrete Frage oder ein bestehendes Projekt: Erzähl mir, wo du stehst. Gemeinsam klären wir, was sinnvoll ist.','An idea, a specific question or an existing project: tell me where you are. Together, we’ll work out what makes sense.')}</p><a class="button button-mint" href={contact}>{t('Georgia kontaktieren','Contact Georgia')}<Icon name="diagonal" size={20}/></a></div><div class="related-services"><h2>{t('Perspektiven verbinden.','Connect perspectives.')}</h2><div>{related.map(s=><a href={href(`/leistungen/${s.slug}/`,lang)}><Icon name={s.icon} size={24}/><span>{s.title}</span><Icon name="diagonal" size={20}/></a>)}</div></div></section>
 </div>
</Layout>
<script>
 const motion=matchMedia('(prefers-reduced-motion: reduce)');
 const running=new Set<Animation>();
 document.querySelectorAll<HTMLDetailsElement>('.service-page details').forEach(detail=>detail.addEventListener('toggle',()=>{
  if(!detail.open||motion.matches)return;
  const content=detail.querySelector('.step-content')||detail.querySelector('p');
  if(content){const animation=content.animate([{transform:'translateY(-6px)'},{transform:'translateY(0)'}],{duration:260,easing:'ease-out'});running.add(animation);animation.onfinish=()=>running.delete(animation);}
 }));
 if(!motion.matches&&'IntersectionObserver' in window){
  const observer=new IntersectionObserver(entries=>{for(const entry of entries){if(entry.isIntersecting){const a=entry.target.animate([{transform:'translateY(24px)'},{transform:'translateY(0)'}],{duration:650,easing:'cubic-bezier(.2,.7,.2,1)'});running.add(a);a.onfinish=()=>running.delete(a);observer.unobserve(entry.target);}}},{threshold:.08});
  document.querySelectorAll('[data-service-reveal]').forEach(el=>observer.observe(el));
  motion.addEventListener('change',e=>{if(e.matches){observer.disconnect();running.forEach(a=>a.cancel());running.clear();}});
 }
</script>
