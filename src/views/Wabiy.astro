---
import Layout from '../layouts/Layout.astro';
import WabiyBird from '../components/WabiyBird';
import QuickAudit from '../components/QuickAudit';
import Icon from '../components/Icon.astro';
import {language,href} from '../i18n';
const lang=language(Astro.url.pathname);const en=lang==='en';const t=(de:string,eng:string)=>en?eng:de;
const base=en?'https://wabiy.com/en/':'https://wabiy.com/de/';
const pillars=[
 {icon:'access',number:'01',label:'AUDIT',title:t('Barrieren sichtbar machen.','Make barriers visible.'),text:t('Automatisierte Audits untersuchen unter anderem Seitenstruktur, Kontraste und ARIA-Auszeichnungen. Die Ergebnisse zeigen, wo genauer hingesehen werden sollte.','Automated audits examine page structure, contrast and ARIA markup, among other things. Results show where a closer look is needed.'),link:base,labelLink:t('Website auf Wabiy prüfen','Audit a website on Wabiy')},
 {icon:'code',number:'02',label:'DEVELOPER',title:t('Vom Befund zur Verbesserung.','Turn findings into improvements.'),text:t('Verständliche Aufgaben und konkrete Code-Vorschläge unterstützen die Umsetzung. Wabiy beschreibt außerdem GitHub- und GitLab-Workflows für Entwicklungsteams.','Understandable tasks and concrete code suggestions support implementation. Wabiy also describes GitHub and GitLab workflows for development teams.'),link:base+'platform/',labelLink:t('Den Code-Workflow entdecken','Explore the code workflow')},
 {icon:'design',number:'03',label:'MEDIA',title:t('Inhalte zugänglicher erzählen.','Make content more accessible.'),text:t('Zum Plattformangebot gehören Werkzeuge für Medienuntertitel und Transkripte. WebVTT- und SRT-Formate helfen dabei, Video-Inhalte über zusätzliche Zugänge bereitzustellen.','The platform includes tools for captions and transcripts. WebVTT and SRT formats help offer additional ways to access video content.'),link:base+'platform/',labelLink:t('Medien-Werkzeuge kennenlernen','Explore media tools')},
 {icon:'strategy',number:'04',label:'ACADEMY',title:t('Wissen im Team verankern.','Build knowledge across the team.'),text:t('Lernangebote und ein Kanal für Barriere-Meldungen ergänzen die technischen Prüfungen. So werden Wissen, Nutzerfeedback und Entwicklung miteinander verbunden.','Learning resources and a barrier reporting channel complement technical checks, connecting knowledge, user feedback and development.'),link:base+'platform/',labelLink:t('Mehr über die Plattform','More about the platform')},
];
const steps=en?[
 ['Discover','Identify potential barriers through automated checks.'],['Understand','Understand the criterion and its impact on people.'],['Improve','Prioritise tasks and improve the source code.'],['Verify','Retest changes and include manual evaluation.'],['Maintain','Make accessibility part of ongoing development.']
]:[['Entdecken','Potenzielle Barrieren durch automatisierte Prüfungen finden.'],['Verstehen','Kriterium und Auswirkungen auf Menschen nachvollziehen.'],['Verbessern','Aufgaben priorisieren und den Quellcode weiterentwickeln.'],['Überprüfen','Änderungen nachtesten und manuell bewerten.'],['Dranbleiben','Zugänglichkeit in der laufenden Entwicklung mitdenken.']];
---
<Layout title={t('Wabiy – Technologie für ein zugänglicheres Web | Georgia König','Wabiy – Technology for a more accessible web | Georgia König')} description={t('Lerne Wabiy kennen: digitale Barrierefreiheit mit Audits, Code-Workflows, Medienuntertiteln und Wissen für Teams. Ein gemeinsames Projekt mit Georgia König.','Meet Wabiy: digital accessibility with audits, code workflows, media captions and team learning. A collaborative project involving Georgia König.')}>
 <section class="wabiy-hero"><div class="container"><nav class="breadcrumb" aria-label={t('Brotkrümelnavigation','Breadcrumbs')}><a href={href('/',lang)}>{t('Startseite','Home')}</a><span aria-hidden="true">/</span><span aria-current="page">Wabiy</span></nav><div class="wabiy-hero-grid"><div><p class="eyebrow"><span class="status-dot"/>{t('EINE GEMEINSAME MISSION','A SHARED MISSION')} / WABIY</p><h1>{t('Mehr Teilhabe.','More inclusion.')}<br/>{t('Weniger Barrieren.','Fewer barriers.')}<br/><span>{t('Hallo, Wabiy','Hello, Wabiy')}<span aria-hidden="true">.</span></span></h1><p class="intro">{t('Digitale Barrierefreiheit braucht gute Werkzeuge. Und Menschen, die sie verstehen. Mit Wabiy bringen wir beides zusammen.','Digital accessibility needs good tools. And people who understand them. With Wabiy, we bring both together.')}</p><div class="hero-actions"><a class="button button-mint" href={base}>{t('Wabiy kennenlernen','Discover Wabiy')}<Icon name="diagonal" size={20}/></a><a href="#plattform" class="text-link">{t('Was steckt dahinter?','What’s behind it?')}<span aria-hidden="true">↓</span></a></div></div><div class="wabiy-hero-bird"><div class="bird-halo" aria-hidden="true"></div><span class="art-label label-one">&lt;accessible by design /&gt;</span><WabiyBird lang={lang} client:load/><span class="art-label label-two"><Icon name="check" size={14}/>{t('Menschen zuerst. Immer.','People first. Always.')}</span></div></div></div></section>
 <div class="expertise-strip"><div class="container"><span>WABIY / THE BIG PICTURE</span><span>Audit</span><i aria-hidden="true">✳</i><span>Code</span><i aria-hidden="true">✳</i><span>Media</span><i aria-hidden="true">✳</i><span>Academy</span></div></div>
 <section class="section"><div class="container wabiy-intro-grid"><div><p class="eyebrow">THE WHY / {t('UNSERE PERSPEKTIVE','OUR PERSPECTIVE')}</p><h2>{t('Zugänglichkeit ist','Accessibility is')}<br/><span class="muted-heading">{t('eine Teamaufgabe.','a team effort.')}</span></h2></div><div><p>{t('Wabiy unterstützt Unternehmen, Agenturen und Entwicklungsteams dabei, digitale Barrieren zu analysieren und schrittweise zu reduzieren. Der Ansatz verbindet technische Prüfungen mit verständlichen nächsten Schritten.','Wabiy helps businesses, agencies and development teams analyse and gradually reduce digital barriers. Its approach combines technical checks with understandable next steps.')}</p><p>{t('Ich arbeite gemeinsam mit Karam Hayani an diesem Projekt. Meine Perspektive aus UX-Design, Informatik und Accessibility gehört dabei zu einer größeren Idee: digitale Teilhabe im Alltag der Produktentwicklung verankern.','I work on this project together with Karam Hayani. My perspective from UX design, computer science and accessibility contributes to a larger idea: making digital inclusion part of everyday product development.')}</p><a class="text-link" href={base+'about/'}>{t('Zur Mission von Wabiy','Explore Wabiy’s mission')}<Icon name="diagonal" size={18}/></a></div></div></section>
 <section id="plattform" class="section lab-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">THE PLATFORM / {t('VIER PERSPEKTIVEN, EIN ZIEL','FOUR PERSPECTIVES, ONE GOAL')}</p><h2>{t('Vom ersten Befund','From an initial finding')}<br/><span class="muted-heading">{t('zum nächsten Schritt.','to the next step.')}</span></h2></div><p>{t('Wabiy bündelt Analyse, Umsetzung, Medien und Lernen in einem gemeinsamen Arbeitskontext.','Wabiy brings analysis, implementation, media and learning into a shared working environment.')}</p></div><div class="wabiy-pillars">{pillars.map(p=><article class="wabiy-pillar"><div class="wabiy-pillar-top"><Icon name={p.icon} size={30}/><span class="mono">{p.number} / {p.label}</span></div><h3>{p.title}</h3><p>{p.text}</p><a class="text-link" href={p.link}>{p.labelLink}<Icon name="diagonal" size={17}/></a></article>)}</div></div></section>
 <QuickAudit lang={lang} client:visible />

 <section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">THE WORKFLOW / {t('KONTINUIERLICH STATT EINMALIG','CONTINUOUS, NOT ONE-OFF')}</p><h2>{t('Ein Prozess.','A process.')}<br/><span class="muted-heading">{t('Der weitergeht.','That keeps going.')}</span></h2></div><p>{t('Neue Inhalte und neue Funktionen verändern digitale Produkte. Zugänglichkeit braucht deshalb einen festen Platz im Entwicklungsprozess.','New content and features change digital products. Accessibility needs an ongoing place in the development process.')}</p></div><ol class="workflow-grid">{steps.map(([title,text],i)=><li><span class="mono">0{i+1} / WABIY</span><h3>{title}</h3><p>{text}</p></li>)}</ol></div></section>
 <section class="section" style="padding-top:0"><div class="container"><div class="wabiy-code-feature"><div><p class="eyebrow">AT THE SOURCE / {t('DIREKT IM CODE','DIRECTLY IN CODE')}</p><h2>{t('Gute Lösungen','Good solutions')}<br/>{t('gehen an die Wurzel.','start at the source.')}</h2><p>{t('Der Wabiy-Ansatz zielt auf Verbesserungen am Quellcode. Eine verständliche Beschriftung, eine passende HTML-Struktur oder ein nachvollziehbarer Fokus sollen Teil des Produkts werden.','Wabiy’s approach focuses on improving source code. Clear labels, appropriate HTML structure and understandable focus should become part of the product itself.')}</p><p>{t('Das Beispiel zeigt das Prinzip: Ein Symbol-Button bekommt einen zugänglichen Namen. Es ist eine Illustration und kein Live-Audit.','This example illustrates the idea: an icon button receives an accessible name. It is an illustration, not a live audit.')}</p></div><div class="code-window"><div class="code-window-top"><span>component.tsx</span><span>ILLUSTRATION / A11Y</span></div><code><span class="code-del">{'− <button><IconSearch /></button>'}</span><br/><br/><span class="code-add">{'+ <button'}<br/>{'    aria-label="'+t('Suche öffnen','Open search')+'"'}<br/>{'  >'}<br/>{'    <IconSearch aria-hidden="true" />'}<br/>{'  </button>'}</span></code><span class="code-caption">{t('VERSTÄNDLICHER NAME → KLARERE BEDIENUNG','MEANINGFUL NAME → CLEARER INTERACTION')}</span></div></div></div></section>
 <section class="section wabiy-closing"><div class="container"><p class="eyebrow">TECHNOLOGY + HUMAN EXPERTISE</p><h2>{t('Werkzeuge helfen.','Tools help.')}<br/>{t('Menschen machen den Unterschied.','People make the difference.')}</h2><p>{t('Automatisierte Prüfungen liefern wertvolle Hinweise. Sie ersetzen weder die vollständige manuelle Begutachtung noch Tests mit Nutzer:innen und sind keine rechtliche Konformitätsgarantie.','Automated checks provide valuable insights. They do not replace a full manual evaluation or testing with users, and they do not provide a legal guarantee of compliance.')}</p><a class="button button-mint" href={base}>{t('Zur Wabiy-Website','Visit Wabiy')}<Icon name="diagonal" size={19}/></a><a class="button button-outline" href={href('/#kontakt',lang)}>{t('Mit mir darüber sprechen','Talk to me about it')}<Icon name="arrow" size={19}/></a><p class="source-note">{t('Plattforminformationen nach','Platform information based on')} <a href={base}>wabiy.com</a> · {t('Stand: 8. November 2026. Funktionen und Verfügbarkeit beim Anbieter prüfen.','As of 8 November 2026. Check features and availability with the provider.')}</p></div></section>
</Layout>
